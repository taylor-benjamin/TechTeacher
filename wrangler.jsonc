{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techteacher",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this, the SPA fallback would answer /api requests with index.html.
    "run_worker_first": ["/api/*"]
  },
  // No database_id: wrangler creates the database on the first deploy and reuses it (by name) after that.
  "d1_databases": [{ "binding": "DB", "database_name": "techteacher-db" }],
  "observability": { "enabled": true }
}
