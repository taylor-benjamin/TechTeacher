{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techteacher",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request reaches the Worker first so it can redirect www and route /api
    // (otherwise the SPA fallback would answer /api requests with index.html).
    "run_worker_first": true
  },
  // Wrangler creates the DNS records and certificates for these on deploy.
  "routes": [
    { "pattern": "techteacher.page", "custom_domain": true },
    { "pattern": "www.techteacher.page", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true,
  // No database_id: wrangler creates the database on the first deploy and reuses it (by name) after that.
  "d1_databases": [{ "binding": "DB", "database_name": "techteacher-db" }],
  "observability": { "enabled": true },
  // Preview builds (pull requests, `npx wrangler preview`) need this block. Left empty on purpose:
  // previews get the site but no database binding, so they can never touch real user data.
  "previews": {}
}
